# ===== DeepSeek 大模型配置 =====
# 使用方式：复制本文件为 .env.local 并填入密钥
#   未配置密钥时，应用自动运行在 Mock 模式（内置示例数据），保证开箱即用。
#   配置后无需改任何代码，所有 Agent 自动切换到真实大模型输出。
DEEPSEEK_API_KEY=

# 可选：覆盖默认模型。deepseek-chat（通用对话）/ deepseek-reasoner（深度推理）
DEEPSEEK_MODEL=deepseek-chat

# ===== 数据库（PostgreSQL，Prisma）=====
# 本地开发与 Railway 部署均需配置。Railway 添加 PostgreSQL 插件后会自动注入。
# 本地若无 Postgres，可指向 Railway 的数据库（railway run 或复制其连接串）。
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/researchos?schema=public

# ===== 认证（Auth.js v5）=====
# JWT 签名密钥，生产环境必填。生成方式：openssl rand -base64 32
AUTH_SECRET=
